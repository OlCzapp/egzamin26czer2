<Window x:Class="egzamin26czer2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:egzamin26czer2"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Szyfrowanie, stworzone przez OlCz" Height="200" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Label Foreground="AntiqueWhite">Podaj wartość klucza:</Label>
            <TextBox Margin="0,10,0,20" HorizontalAlignment="Center" Width="50"></TextBox>

            <Label Foreground="AntiqueWhite">Podaj tekst:</Label>
            <TextBox Margin="10" HorizontalAlignment="Center" Width="150" Height="65" TextWrapping="Wrap"></TextBox>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Background="LightBlue" FontSize="8" Padding="4">Zaszyfruj</Button>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Label Foreground="AntiqueWhite">Tekst zaszyfrowany</Label>
            <StackPanel HorizontalAlignment="Center">
                <GroupBox BorderBrush="AntiqueWhite " Width="150" Height="120">
                    <StackPanel>
                        <TextBlock Margin="20" Foreground="AliceBlue" Text=""></TextBlock>
                    </StackPanel>
                </GroupBox>
                <Button Background="LightBlue" FontSize="10" Margin="10">
                    Zapisz szyfr w pliku
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
