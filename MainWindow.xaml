<Window x:Class="egzamin26czer2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:egzamin26czer2"
        mc:Ignorable="d"
        Background="CadetBlue"
        Title="Szyfrowanie, stworzone przez OlCz" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Label FontSize="20" Foreground="AntiqueWhite">Podaj wartość klucza:</Label>
            <TextBox x:Name="wartosc_klucza" Margin="0,10,0,20" HorizontalAlignment="Center" Width="50"></TextBox>

            <Label FontSize="20" Foreground="AntiqueWhite">Podaj tekst:</Label>
            <TextBox x:Name="text_do_szyfru" Text=" " Margin="10" HorizontalAlignment="Center" Width="300" Height="230" TextWrapping="Wrap"></TextBox>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="zaszyfruj" Click="zaszyfruj_Click" Background="LightBlue" FontSize="10" Padding="4">Zaszyfruj</Button>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Label FontSize="20" Foreground="AntiqueWhite">Tekst zaszyfrowany</Label>
            <StackPanel HorizontalAlignment="Center">
                <GroupBox BorderBrush="AntiqueWhite" Width="300" Height="280">
                    <StackPanel>
                        <TextBlock x:Name="zaszyfrowany_text" Margin="20" Foreground="AliceBlue" Text=""></TextBlock>
                    </StackPanel>
                </GroupBox>
                <Button x:Name="zapisz_w_txt" Click="zapisz_w_txt_Click" Background="LightBlue" FontSize="15" Margin="20">
                    Zapisz szyfr w pliku
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
